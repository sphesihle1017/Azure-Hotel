@model IEnumerable<HotelManager.Models.Room>

@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_Layout";
}

<style>
    .footer {
        visibility: hidden;
    }

    .dashboard-card {
        transition: .3s;
        border: none;
        border-radius: 15px;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,.15);
        }

    .dashboard-icon {
        font-size: 55px;
    }

    .table td,
    .table th {
        vertical-align: middle;
    }
</style>

<div class="container mt-4">

    <!-- Welcome -->
    <div class="p-5 mb-4 bg-info text-white rounded-4 shadow">

        <h2>
            Welcome, @User.Identity?.Name!
        </h2>

        <p class="mb-0">
            Browse available rooms, make reservations and manage your bookings.
        </p>

    </div>

    <!-- Quick Actions -->
    <div class="row g-4 mb-5">

        <!-- Browse Rooms -->
        <div class="col-md-4">

            <div class="card dashboard-card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-door-open dashboard-icon text-primary"></i>

                    <h4 class="mt-3">Browse Rooms</h4>

                    <p class="text-muted">
                        View available rooms and make a reservation.
                    </p>

                    <a asp-controller="Bookings"
                       asp-action="Create"
                       class="btn btn-primary">

                        Browse Rooms

                    </a>

                </div>

            </div>

        </div>

        <!-- My Bookings -->
        <div class="col-md-4">

            <div class="card dashboard-card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-calendar-check dashboard-icon text-success"></i>

                    <h4 class="mt-3">My Bookings</h4>

                    <p class="text-muted">
                        View your upcoming and previous bookings.
                    </p>

                    <a asp-controller="Bookings"
                       asp-action="ViewBookings"
                       class="btn btn-success">

                        View Bookings

                    </a>

                </div>

            </div>

        </div>

        <!-- My Profile -->
        <div class="col-md-4">

            <div class="card dashboard-card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-person-circle dashboard-icon text-warning"></i>

                    <h4 class="mt-3">My Profile</h4>

                    <p class="text-muted">
                        Manage your account information.
                    </p>

                    <a asp-controller="Manage"
                       asp-action="Index"
                       class="btn btn-warning text-white">

                        Manage Profile

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Available Rooms -->
    <div class="card shadow">

        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                Available Rooms
            </h4>

            <a asp-controller="Bookings"
               asp-action="Create"
               class="btn btn-light btn-sm">

                View All

            </a>

        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-4">

                    <i class="bi bi-door-closed fs-1 text-muted"></i>

                    <h5 class="mt-3 text-muted">
                        No rooms available.
                    </h5>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>Hotel</th>
                                <th>Room Type</th>
                                <th>Price / Night</th>
                                <th>Available</th>
                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var room in Model.Take(6))
                            {
                                <tr>

                                    <td>
                                        @room.Hotel.Name
                                    </td>

                                    <td>
                                        @room.RoomDescription
                                    </td>

                                    <td>
                                        <strong>
                                            R @room.PricePerNight.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>

                                        @if (room.Quantity > 0)
                                        {
                                            <span class="badge bg-success">

                                                @room.Quantity Available

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                Fully Booked

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (room.Quantity > 0)
                                        {
                                            <a asp-controller="Bookings"
                                               asp-action="Create"
                                               asp-route-roomId="@room.RoomId"
                                               class="btn btn-primary btn-sm">

                                                Book Now

                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled>

                                                Unavailable

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>