@model HotelManager.Models.Room

@{
    ViewData["Title"] = "Room Details";
    Layout = "_Layout";
}
<style>
    footer{
        visibility:hidden;
    }
</style>

<div class="container mt-4">

    <h2 class="mb-4">Room Details</h2>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h4>@Model.Hotel.Name</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <dl class="row">

                        <dt class="col-sm-5">Room Type</dt>
                        <dd class="col-sm-7">@Model.RoomDescription</dd>

                        <dt class="col-sm-5">Hotel</dt>
                        <dd class="col-sm-7">@Model.Hotel.Name</dd>

                        <dt class="col-sm-5">Location</dt>
                        <dd class="col-sm-7">@Model.Hotel.Location</dd>

                        <dt class="col-sm-5">Price Per Night</dt>
                        <dd class="col-sm-7">
                            R @Model.PricePerNight.ToString("N2")
                        </dd>

                    </dl>

                </div>

                <div class="col-md-6">

                    <div class="row text-center">

                        <div class="col">
                            <div class="card bg-secondary text-white">
                                <div class="card-body">
                                    <h3>@Model.Quantity</h3>
                                    <small>Total Rooms</small>
                                </div>
                            </div>
                        </div>

                        <div class="col">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <h3>@ViewBag.BookedRooms</h3>
                                    <small>Booked</small>
                                </div>
                            </div>
                        </div>

                        <div class="col">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <h3>@ViewBag.AvailableRooms</h3>
                                    <small>Available</small>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card mt-4 shadow-sm">

        <div class="card-header">
            <h4>Booking History</h4>
        </div>

        <div class="card-body">

            @if (Model.Bookings.Any())
            {
                <table class="table table-bordered table-striped">

                    <thead>

                        <tr>
                            <th>Customer</th>
                            <th>Email</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Total Paid</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>

                                <td>
                                    @booking.Customer.FirstName
                                    @booking.Customer.LastName
                                </td>

                                <td>
                                    @booking.Customer.Email
                                </td>

                                <td>
                                    @booking.CheckInDate.ToShortDateString()
                                </td>

                                <td>
                                    @booking.CheckOutDate.ToShortDateString()
                                </td>

                                <td>
                                    R @booking.TotalAmount.ToString("N2")
                                </td>

                                <td>
                                    @booking.BookingStatus
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="alert alert-info">
                    No bookings have been made for this room.
                </div>
            }

        </div>

    </div>

    <div class="mt-3">

        <a asp-action="Rooms" class="btn btn-secondary">
            Back
        </a>

        <a asp-action="EditRoom"
           asp-route-id="@Model.RoomId"
           class="btn btn-warning">
            Edit Room
        </a>

    </div>

</div>